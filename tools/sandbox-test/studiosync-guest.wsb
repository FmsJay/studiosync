<Configuration>
  <Networking>Enable</Networking>
  <MemoryInMB>6144</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\Agent Workspace\studiosync-sandbox\ss</HostFolder>
      <SandboxFolder>C:\ss</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Minimized -File C:\ss\setup.ps1</Command>
  </LogonCommand>
</Configuration>
